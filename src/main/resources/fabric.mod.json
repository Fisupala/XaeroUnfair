{
  "schemaVersion": 1,
  "id": "xaerounfair",
  "version": "${version}",
  "name": "XaeroUnfair",
  "description": "A lightweight Fabric mod that disables server-enforced FairPlay rules for **Xaero's Minimap** and **Xaero's WorldMap**.",
  "authors": [
    "Fisupala"
  ],
  "contact": {
    "homepage": "github.com/Fisupala/XaeroUnfair",
    "sources": "github.com/Fisupala/XaeroUnfair",
    "issues": "github.com/Fisupala/XaeroUnfair/issues"
  },
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.fisupala.xaerounfair.client.XaerounfairClient"
    ],
    "main": [
      "org.fisupala.xaerounfair.Xaerounfair"
    ]
  },
  "mixins": [
    {
      "config": "xaerounfair.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.160.5",
    "minecraft": "26.3"
  },
  "suggests": {
    "xaerominimap": ">=25.5.2",
    "xaeroworldmap": ">=1.46.3"
  }
}